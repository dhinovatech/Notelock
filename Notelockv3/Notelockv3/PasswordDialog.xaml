<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Notelockv3.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Notelockv3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title=""
    PrimaryButtonText="Continue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    CornerRadius="12"
    MaxWidth="480">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10">
        <StackPanel Spacing="16" Width="360" HorizontalAlignment="Center">
            <!-- SVG Lock Icon -->
            <Viewbox Height="44" Width="44" HorizontalAlignment="Center">
                <Path Data="M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M8.9,6C8.9,4.29 10.29,2.9 12,2.9C13.71,2.9 15.1,4.29 15.1,6V8H8.9V6M18,20H6V10H18V20M12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13Z"
                      Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Viewbox>

            <!-- Header Titles -->
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="TitleLabel"
                           Text="Security Verification" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleLabel"
                           Text="Enter password to access the file" 
                           FontSize="13" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Input Fields -->
            <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PasswordLabel"
                               Text="Password" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <PasswordBox x:Name="PasswordEntry" 
                                 PlaceholderText="Enter password"
                                 AutomationProperties.Name="Password Entry"
                                 Height="38"
                                 KeyDown="OnPasswordKeyDown" />
                </StackPanel>

                <StackPanel x:Name="ConfirmPasswordLayout" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="ConfirmPasswordLabel"
                               Text="Confirm Password" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <PasswordBox x:Name="ConfirmPasswordEntry" 
                                 PlaceholderText="Repeat password"
                                 AutomationProperties.Name="Confirm Password Entry"
                                 Height="38"
                                 KeyDown="OnConfirmPasswordKeyDown" />
                </StackPanel>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorLabel" 
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                       FontSize="13"
                       Visibility="Collapsed" 
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
