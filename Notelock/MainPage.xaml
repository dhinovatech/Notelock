<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notelock.MainPage"
             Title="Notelock - Untitled"
             Shell.NavBarIsVisible="True"
             Shell.NavBarHasShadow="False">

    <Shell.TitleView>
        <Grid WidthRequest="0" HeightRequest="0" Margin="0" Padding="0" />
    </Shell.TitleView>

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="New" Clicked="OnNewClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="New Window" Clicked="OnNewWindowClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Ctrl,Shift" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Open..." Clicked="OnOpenClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Save" Clicked="OnSaveClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Save As..." Clicked="OnSaveAsClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Ctrl,Shift" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" Clicked="OnExitClicked" />
        </MenuBarItem>
        
        <MenuBarItem Text="Edit">
            <MenuFlyoutItem Text="Undo" Clicked="OnUndoClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Z" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Cut" Clicked="OnCutClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="X" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Copy" Clicked="OnCopyClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Paste" Clicked="OnPasteClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="V" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Delete" Clicked="OnDeleteClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Find..." Clicked="OnFindClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Find Next" Clicked="OnFindNextMenuClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F3" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Find Previous" Clicked="OnFindPrevMenuClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F3" Modifiers="Shift" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Replace..." Clicked="OnReplaceMenuClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="H" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Go To..." Clicked="OnGoToClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="G" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Select All" Clicked="OnSelectAllClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="A" Modifiers="Ctrl" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Time/Date" Clicked="OnTimeDateClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>

        <MenuBarItem Text="Format">
            <MenuFlyoutItem x:Name="WordWrapMenuItem" Text="✓ Word Wrap" Clicked="OnWordWrapClicked" />
        </MenuBarItem>

        <MenuBarItem Text="View">
            <MenuFlyoutSubItem Text="Zoom">
                <MenuFlyoutItem x:Name="ZoomInMenuItem" Text="Zoom In" Clicked="OnZoomInClicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="OemPlus" Modifiers="Ctrl" />
                        <KeyboardAccelerator Key="Add" Modifiers="Ctrl" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ZoomOutMenuItem" Text="Zoom Out" Clicked="OnZoomOutClicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="OemMinus" Modifiers="Ctrl" />
                        <KeyboardAccelerator Key="Subtract" Modifiers="Ctrl" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Restore Default Zoom" Clicked="OnZoomResetClicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="0" Modifiers="Ctrl" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem x:Name="StatusBarMenuItem" Text="✓ Status Bar" Clicked="OnStatusBarToggleClicked" />
        </MenuBarItem>

        <MenuBarItem Text="Help">
            <MenuFlyoutItem Text="About Notelock" Clicked="OnAboutClicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Find/Replace Panel -->
        <Border x:Name="FindReplacePanel" 
                Grid.Row="0" 
                IsVisible="False" 
                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E24}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}"
                StrokeThickness="1"
                Padding="10"
                Margin="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            
            <VerticalStackLayout Spacing="8">
                <!-- Find Row -->
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="8">
                    <!-- Find Input -->
                    <Entry x:Name="FindEntry" 
                           Grid.Column="0"
                           Placeholder="Find text..."
                           PlaceholderColor="Gray"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#12121A}"
                           HeightRequest="36"
                           TextChanged="OnFindTextChanged" />
                    
                    <!-- Find Prev -->
                    <Button Grid.Column="1" 
                            Text="▲" 
                            WidthRequest="36" 
                            HeightRequest="36"
                            Padding="0"
                            Clicked="OnFindPrevClicked"
                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    
                    <!-- Find Next -->
                    <Button Grid.Column="2" 
                            Text="▼" 
                            WidthRequest="36" 
                            HeightRequest="36"
                            Padding="0"
                            Clicked="OnFindNextClicked"
                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    
                    <!-- Match Case Toggle -->
                    <HorizontalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="5">
                        <CheckBox x:Name="MatchCaseCheckBox" IsChecked="False" VerticalOptions="Center" />
                        <Label Text="Match Case" VerticalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    </HorizontalStackLayout>
                    
                    <!-- Close button -->
                    <Button Grid.Column="4" 
                            Text="✕" 
                            WidthRequest="36" 
                            HeightRequest="36"
                            Padding="0"
                            Clicked="OnCloseFindReplaceClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </Grid>

                <!-- Replace Row -->
                <Grid x:Name="ReplaceRow" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" IsVisible="False">
                    <!-- Replace Input -->
                    <Entry x:Name="ReplaceEntry" 
                           Grid.Column="0"
                           Placeholder="Replace with..."
                           PlaceholderColor="Gray"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#12121A}"
                           HeightRequest="36" />
                    
                    <!-- Replace button -->
                    <Button Grid.Column="1" 
                            Text="Replace" 
                            HeightRequest="36"
                            Clicked="OnReplaceClicked"
                            BackgroundColor="#0078D7"
                            TextColor="White"
                            Padding="15,0" />
                    
                    <!-- Replace All button -->
                    <Button Grid.Column="2" 
                            Text="Replace All" 
                            HeightRequest="36"
                            Clicked="OnReplaceAllClicked"
                            BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            Padding="15,0" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Main Editor -->
        <Editor x:Name="MainEditor"
                Grid.Row="1"
                Placeholder="Start typing..."
                AutoSize="Disabled"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand" 
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                FontFamily="Consolas"
                FontSize="14"
                Margin="5"
                />

        <!-- Status Bar -->
        <Grid x:Name="StatusBar"
              Grid.Row="2"
              ColumnDefinitions="*, Auto, Auto, Auto, Auto"
              BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1E1E24}"
              HeightRequest="26"
              Padding="10,0"
              VerticalOptions="End">
            
            <Label Grid.Column="0" 
                   x:Name="StatusBarFileNameLabel" 
                   Text="Untitled" 
                   TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                   FontSize="12" 
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            
            <!-- Ln X, Col Y -->
            <Label Grid.Column="1" 
                   x:Name="CursorPosLabel" 
                   Text="Ln 1, Col 1" 
                   TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                   FontSize="12" 
                   VerticalOptions="Center" 
                   Margin="15,0" />
            
            <!-- Zoom Level -->
            <Label Grid.Column="2" 
                   x:Name="ZoomLabel" 
                   Text="100%" 
                   TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                   FontSize="12" 
                   VerticalOptions="Center" 
                   Margin="15,0" />
            
            <!-- Line Endings -->
            <Label Grid.Column="3" 
                   x:Name="LineEndingsLabel" 
                   Text="Windows (CRLF)" 
                   TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                   FontSize="12" 
                   VerticalOptions="Center" 
                   Margin="15,0" />
            
            <!-- Encoding -->
            <Label Grid.Column="4" 
                   x:Name="EncodingLabel" 
                   Text="UTF-8" 
                   TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                   FontSize="12" 
                   VerticalOptions="Center" 
                   Margin="15,0" />
        </Grid>
    </Grid>

</ContentPage>
