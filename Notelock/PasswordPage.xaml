<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notelock.PasswordPage"
             Title="Security"
             BackgroundColor="#09090D">

    <!-- Overall layout centering the card -->
    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <Border BackgroundColor="#15151F"
                Stroke="#2A2A38"
                StrokeThickness="1"
                WidthRequest="400"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="30"
                Margin="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,8" Radius="15" Opacity="0.6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                
                <!-- SVG Lock Icon -->
                <Path Data="M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M8.9,6C8.9,4.29 10.29,2.9 12,2.9C13.71,2.9 15.1,4.29 15.1,6V8H8.9V6M18,20H6V10H18V20M12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13Z"
                      Fill="#0078D7" 
                      HeightRequest="44" 
                      WidthRequest="44" 
                      HorizontalOptions="Center" 
                      Aspect="Uniform" />

                <!-- Text Header -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="TitleLabel"
                           Text="Security Verification" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label x:Name="SubtitleLabel"
                           Text="Enter password to access the file" 
                           FontSize="13" 
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                
                <!-- Input Controls -->
                <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                    
                    <!-- Password Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="#D1D5DB" />
                        <Entry x:Name="PasswordEntry" 
                               IsPassword="True" 
                               Placeholder="Enter password"
                               PlaceholderColor="#6B7280"
                               TextColor="White"
                               BackgroundColor="#1E1E2A"
                               HeightRequest="40"
                               VerticalOptions="Center"
                               Completed="OnPasswordCompleted" />
                    </VerticalStackLayout>
 
                    <!-- Confirm Password Field -->
                    <VerticalStackLayout x:Name="ConfirmPasswordLayout" Spacing="6" IsVisible="False">
                        <Label Text="Confirm Password" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="#D1D5DB" />
                        <Entry x:Name="ConfirmPasswordEntry" 
                               IsPassword="True" 
                               Placeholder="Repeat password"
                               PlaceholderColor="#6B7280"
                               TextColor="White"
                               BackgroundColor="#1E1E2A"
                               HeightRequest="40"
                               VerticalOptions="Center"
                               Completed="OnConfirmPasswordCompleted" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Error Display -->
                <Label x:Name="ErrorLabel" 
                       TextColor="#EF4444" 
                       FontSize="13"
                       IsVisible="False" 
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,5,0,0" />

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel" 
                            Clicked="OnCancelClicked" 
                            BackgroundColor="#2D2D3F" 
                            TextColor="White"
                            HeightRequest="40"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="13" />
                    <Button x:Name="ActionBtn"
                            Grid.Column="1"
                            Text="Continue" 
                            Clicked="OnActionClicked" 
                            BackgroundColor="#0078D7" 
                            TextColor="White"
                            HeightRequest="40"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="13" />
                </Grid>
                
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
