<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notelock.PasswordPage"
             Title="Security"
             BackgroundColor="#1E1E1E">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="PlaceholderColor" Value="#AAAAAA"/>
            <Setter Property="BackgroundColor" Value="#333333"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        <Label Text="Security Enforcer" 
               FontSize="24" 
               HorizontalOptions="Center" 
               FontAttributes="Bold"/>
        
        <VerticalStackLayout Spacing="10">
            <Label Text="Enter Password" />
            <Entry x:Name="PasswordEntry" 
                   IsPassword="True" 
                   Placeholder="Password" />
            
            <VerticalStackLayout x:Name="ConfirmPasswordLayout" Spacing="10" IsVisible="False">
                <Label Text="Confirm Password" />
                <Entry x:Name="ConfirmPasswordEntry" 
                       IsPassword="True" 
                       Placeholder="Confirm Password" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Label x:Name="ErrorLabel" 
               TextColor="Red" 
               IsVisible="False" 
               HorizontalOptions="Center"/>

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Cancel" 
                    Clicked="OnCancelClicked" 
                    BackgroundColor="#555555" 
                    TextColor="White"/>
            <Button x:Name="ActionBtn" 
                    Text="Continue" 
                    Clicked="OnActionClicked" 
                    BackgroundColor="#512BD4" 
                    TextColor="White"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
